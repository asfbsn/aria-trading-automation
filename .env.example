# Copy to .env (chmod 600) and fill in. NEVER commit the real .env — it is gitignored.

# --- GUI session (so cron's headless env can reach notify-send) ---
DISPLAY=":0"
DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
XDG_RUNTIME_DIR="/run/user/1000"

# --- Claude headless ---
CLAUDE_BIN="claude"
CLAUDE_MODEL="claude-opus-4-8"
CLAUDE_PROJECT_DIR="$HOME/Projects/aria-trading"   # dir where data/universe.csv + scripts/ live
# Auth — use exactly ONE:
#  (A) Subscription OAuth token from `claude setup-token` (note: monthly usage cap):
# export CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat01-...."
#  (B) Pay-per-use API key from console.anthropic.com (recommended for unattended — no subscription cap):
# export ANTHROPIC_API_KEY="sk-ant-api03-...."

# --- Telegram delivery (bot sends the daily report to your chat) ---
export TELEGRAM_BOT_TOKEN="123456789:AA-replace-with-your-bot-token"
export TELEGRAM_CHAT_ID="000000000"

# --- Stale-feed guard (annotation-only by default) ---
HARD_SKIP_ON_UNCHANGED="false"
